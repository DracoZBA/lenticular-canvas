# Copia este archivo como ".env" para desarrollo local y completa tus valores.
# En producción (Vercel), estas mismas variables se configuran en
# Project Settings → Environment Variables — Vercel no lee este archivo.

# --- Supabase (Project Settings → API en supabase.com) ---
SUPABASE_PROJECT_ID="tu-project-id"
SUPABASE_URL="https://tu-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxx"
# Clave secreta (Settings → API → "service_role"). NUNCA la pongas con
# prefijo VITE_ ni la expongas al navegador: solo se usa en el servidor
# para subir fotos a Storage saltándose Row Level Security.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxx"

# Mismas credenciales, expuestas al navegador (Vite las necesita con
# el prefijo VITE_ para el cliente de Supabase del lado del cliente).
VITE_SUPABASE_PROJECT_ID="tu-project-id"
VITE_SUPABASE_URL="https://tu-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxx"

# --- IA generativa (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY="tu-clave-de-gemini"
